# ── Kafka / FactSet EMI ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=factset-emi-broker1:9093,factset-emi-broker2:9093
KAFKA_GROUP_ID=jpm-perf-workflow-monitor
KAFKA_TOPIC=factset.emi.jpm.securities.performance
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=<your-emi-username>
KAFKA_SASL_PASSWORD=<your-emi-password>
KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/factset-ca.pem

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ES_HOSTS=https://es-node1:9200,https://es-node2:9200
ES_INDEX_PREFIX=jpm-perf-workflow
ES_USERNAME=<your-es-username>
ES_PASSWORD=<your-es-password>
ES_CA_CERTS=/etc/ssl/certs/es-ca.pem
ES_VERIFY_CERTS=true
ES_BULK_BATCH_SIZE=100
ES_FLUSH_INTERVAL_SEC=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
